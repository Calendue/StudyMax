{
  "name": "studymax",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:skills": "node --experimental-strip-types scripts/build-skills.ts",
    "cap:assets": "bash scripts/generate-native-assets.sh",
    "cap:sync": "cap sync",
    "build:ios": "bash scripts/build-ios.sh --web",
    "build:android": "bash scripts/build-android.sh --web",
    "db:migrate": "dotenv -e .env.local -- prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:seed:institutions": "node --experimental-strip-types --env-file=.env.local scripts/seed-institutions.ts",
    "db:seed:majors": "node --experimental-strip-types --env-file=.env.local scripts/seed-majors.ts",
    "db:seed:demo-student": "node --experimental-strip-types --experimental-loader ./scripts/_resolve-ts-loader.mjs --env-file=.env.local scripts/seed-demo-student.ts",
    "max:call-log": "node --experimental-strip-types --env-file=.env.local scripts/max-call-log.ts",
    "db:seed": "npm run db:seed:institutions && npm run db:seed:majors",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-inappbrowser": "^8.20.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "@vapi-ai/server-sdk": "^2.0.1",
    "@vapi-ai/web": "^2.7.1",
    "firebase": "^12.19.0",
    "jose": "^6.2.12",
    "motion": "^13.4.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "dotenv-cli": "^11.0.0",
    "oxlint": "^1.75.0",
    "prisma": "^6.19.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "@firebase/util@1.15.3": true,
    "@prisma/client": true,
    "@prisma/engines": true,
    "prisma": true,
    "protobufjs@7.6.6": true
  }
}
