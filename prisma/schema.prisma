generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"] // matches the Vercel deploy target (see api/*.ts)
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (pgbouncer), used at runtime
  directUrl = env("DIRECT_URL") // direct connection, used by the migration engine
}

model UserInfo {
  userId      BigInt   @id @default(autoincrement())
  authUid     String   @unique @db.VarChar // Firebase Auth uid (see src/lib/auth.ts's AuthUser.uid)
  firstName   String?  @db.VarChar
  lastName    String?  @db.VarChar
  email       String?  @db.VarChar
  // What the student typed on onboarding's phone step, for Max's call. Signed-in students only;
  // a guest's number never leaves the device. Validated app-side (api/session.ts), not normalized.
  phoneNumber String?  @db.VarChar
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @db.Timestamp(6)

  profile StudentProfile?
  courses StudentCourse[]
  plan    GeneratedPlan?
}

model StudentProfile {
  profileId     BigInt @id @default(autoincrement())
  userId        BigInt @unique
  studentType   String @db.VarChar // "first-year" | "existing" — validated app-side, no DB enum. Matches OnboardingProfile.studentType.
  institutionId BigInt
  degree        String @db.VarChar
  // Program.id slugs from the static catalogue (e.g. "computer-science"), not freeform names — no FK,
  // catalogue is static. Matches OnboardingProfile.majorProgramId/minorProgramId exactly.
  majorProgramId   String   @db.VarChar
  minorProgramId   String?  @db.VarChar
  // Specialization.id slugs the student is targeting alongside their major — matches
  // OnboardingProfile.concentrationIds. Optional/multi-select; empty when the major has no
  // specialization data or the student skipped it.
  concentrationIds String[]
  // Only set when studentType = "first-year"; null for "existing". Mirrors lib/plan.ts's TermStart shape.
  startingTermSeason String?  @db.VarChar // "Fall" | "Winter"
  startingTermYear   Int?
  goals              String?  @db.Text
  createdAt          DateTime @default(now()) @db.Timestamp(6)
  updatedAt          DateTime @updatedAt @db.Timestamp(6)

  user        UserInfo    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [institutionId], onDelete: Restrict)

  @@index([institutionId])
}

model StudentCourse {
  studentCourseId BigInt   @id @default(autoincrement())
  userId          BigInt
  courseCode      String   @db.VarChar // matches static catalogue codes, e.g. "CMPT145"
  // "completed" | "in_progress" | "registered" — validated app-side. "registered" is onboarding's
  // "What courses have you registered for?" list (this term), kept apart from the transcript's in-progress codes.
  status          String   @db.VarChar
  source          String   @default("manual") @db.VarChar // "manual" | "transcript_upload"
  createdAt       DateTime @default(now()) @db.Timestamp(6)
  updatedAt       DateTime @updatedAt @db.Timestamp(6)

  user UserInfo @relation(fields: [userId], references: [userId], onDelete: Cascade)

  // Same code can have one completed row AND one in_progress row (a retake) — never two of the same status.
  // This compound unique also serves as the userId index (leftmost-prefix), so no separate @@index is needed.
  @@unique([userId, courseCode, status])
}

model GeneratedPlan {
  planId                  BigInt   @id @default(autoincrement())
  userId                  BigInt   @unique // one current plan per student — replaces the localStorage blob
  targetProgramId         String   @db.VarChar // Program.id slug, e.g. "computer-science" — no FK, catalogue is static
  targetSpecializationIds String[] // Specialization.id slugs
  coursesPerTerm          Int      @default(2)
  startSeason             String   @db.VarChar // "Fall" | "Winter"
  startYear               Int
  terms                   Json // PlannedTerm[] snapshot from lib/plan.ts's buildPlan()
  createdAt               DateTime @default(now()) @db.Timestamp(6)
  updatedAt               DateTime @updatedAt @db.Timestamp(6)

  user UserInfo @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

// Seeded from scripts/canadian-institutions-seed.json — mirrors calendue_demo's Institution model.
model Institution {
  institutionId BigInt           @id @default(autoincrement())
  name          String           @unique @db.VarChar
  province      String?          @db.VarChar
  city          String?          @db.VarChar
  country       String?          @db.VarChar
  timezone      String           @db.VarChar
  isCustom      Boolean          @default(false) // true when typed in by a user; excluded from the seeded dropdown
  profiles      StudentProfile[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

// Seeded from scripts/institution-majors.json — mirrors calendue_demo's Major model.
model Major {
  majorId   BigInt   @id @default(autoincrement())
  name      String   @unique @db.VarChar
  isCustom  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
